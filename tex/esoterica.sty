%%
%% Architecture
%% ------------
%%   * Traditions (masonic, goldendawn, ...) are namespaces with a command
%%     prefix.  Each built-in tradition lives in esoterica-<name>.def.
%%   * Glyphs are records in a registry: width, description, optional Unicode
%%     codepoint, and TikZ drawing code on a unit grid.
%%   * Drivers turn a record into a box.  "draw" runs the TikZ code (any
%%     engine); "unicode" typesets the codepoint from a font (XeTeX/LuaTeX).
%%     Each driver falls back to the other.
%%   * Drawn glyphs are cached per (glyph, revision, size, stroke, style,
%%     colour), because TikZ bakes the current colour into the box.
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesExplPackage{esoterica}{2026-09-13}{0.1.0}
  {Glyphs for esoteric traditions}

\RequirePackage{tikz}
\RequirePackage{amstext}

\cs_generate_variant:Nn \prop_gput:Nnn { cnV , cne }
\cs_generate_variant:Nn \int_from_hex:n { V }
\cs_generate_variant:Nn \msg_warning:nnnn { nnne , nnee }

