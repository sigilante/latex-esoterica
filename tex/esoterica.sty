%% Messages

\msg_new:nnn { esoterica } { unknown-glyph }
  { Unknown~glyph~'#1'. }
\msg_new:nnn { esoterica } { unknown-tradition }
  {
    Unknown~tradition~'#1'.~
    Declare~it~first~with~\iow_char:N\\DeclareEsotericTradition.
  }
\msg_new:nnn { esoterica } { unknown-script }
  {
    Unknown~script~'#1'.~
    Declare~it~first~with~\iow_char:N\\DeclareEsotericScript.
  }
\msg_new:nnn { esoterica } { unknown-module }
  { Cannot~find~module~file~'esoterica-#1.def'. }
\msg_new:nnn { esoterica } { glyph-redefined }
  { Redefining~glyph~'#1'. }
\msg_new:nnn { esoterica } { command-exists }
  {
    \iow_char:N\\#1~is~already~defined,~so~it~was~not~generated.~
    Use~\iow_char:N\\eso{#2}~instead.
  }
\msg_new:nnn { esoterica } { no-renderer }
  { Glyph~'#1'~has~no~drawing~and~no~usable~codepoint. }
\msg_new:nnn { esoterica } { no-unicode-engine }
  {
    The~unicode~driver~needs~XeLaTeX~or~LuaLaTeX;~
    glyphs~will~be~drawn~instead.
  }
\msg_new:nnn { esoterica } { missing-char }
  { The~font~has~no~U+#2~for~glyph~'#1';~drawing~it~instead. }
\msg_new:nnn { esoterica } { no-fontspec }
  { The~'font'~key~needs~the~fontspec~package. }

