    \draw (0.41,0.52) -- (0.5,0.52);
    \draw plot[smooth] coordinates {(0.5,0.52) (0.67,0.41) (0.69,0.22) (0.55,0.1) (0.37,0.11) (0.27,0.23) (0.33,0.31)};
