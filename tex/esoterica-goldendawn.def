\DeclareEsotericScript{enochian}{
  A = goldendawn/EnochianUn,
  B = goldendawn/EnochianPe,
  C = goldendawn/EnochianVe,
  K = goldendawn/EnochianVe,
  D = goldendawn/EnochianGal,
  E = goldendawn/EnochianGraph,
  F = goldendawn/EnochianOrth,
  G = goldendawn/EnochianGed,
  H = goldendawn/EnochianNaHath,
  I = goldendawn/EnochianGon,
  J = goldendawn/EnochianGon,
  Y = goldendawn/EnochianGon,
  L = goldendawn/EnochianUr,
  M = goldendawn/EnochianTal,
  N = goldendawn/EnochianDrun,
  O = goldendawn/EnochianMed,
  P = goldendawn/EnochianMals,
  Q = goldendawn/EnochianGer,
  R = goldendawn/EnochianDon,
  S = goldendawn/EnochianFam,
  T = goldendawn/EnochianGisa,
  U = goldendawn/EnochianVau,
  V = goldendawn/EnochianVau,
  W = goldendawn/EnochianVau,
  X = goldendawn/EnochianPal,
  Z = goldendawn/EnochianCeph,
}

