%% Glyphs are drawn on a grid with x from 0 to width and y from 0 to 1.
%% Strokes inherit the package line width; see the manual for conventions.
\ProvidesFile{esoterica-goldendawn.def}[2026-09-13 v0.1.0 esoterica: Golden Dawn]

\DeclareEsotericTradition{goldendawn}{
  name   = Golden Dawn,
  prefix = GoldenDawn,
}

% Elemental triangles share one equilateral frame: y from 0.06 to 0.82.

\DeclareEsotericGlyph{goldendawn}{Fire}{
  description = {Elemental fire},
  unicode     = 1F702,
  draw = {
    \draw (0.0612,0.06) -- (0.9388,0.06) -- (0.5,0.82) -- cycle;
  },
}

\DeclareEsotericGlyph{goldendawn}{Air}{
  description = {Elemental air},
  unicode     = 1F701,
  draw = {
    \draw (0.0612,0.06) -- (0.9388,0.06) -- (0.5,0.82) -- cycle;
    \draw (0.14,0.44) -- (0.86,0.44);
  },
}

\DeclareEsotericGlyph{goldendawn}{Water}{
  description = {Elemental water},
  unicode     = 1F704,
  draw = {
    \draw (0.0612,0.82) -- (0.9388,0.82) -- (0.5,0.06) -- cycle;
  },
}

\DeclareEsotericGlyph{goldendawn}{Earth}{
  description = {Elemental earth},
  unicode     = 1F703,
  draw = {
    \draw (0.0612,0.82) -- (0.9388,0.82) -- (0.5,0.06) -- cycle;
    \draw (0.14,0.44) -- (0.86,0.44);
  },
}

\DeclareEsotericGlyph{goldendawn}{Pentagram}{
  description = {Pentagram, point upward},
  unicode     = 26E4,
  draw = {
    \draw[shift={(0.5,0.47)}]
      (90:0.48) -- (234:0.48) -- (18:0.48) -- (162:0.48) -- (306:0.48) -- cycle;
  },
}

\DeclareEsotericGlyph{goldendawn}{Hexagram}{
  description = {Hexagram of two interlaced triangles},
  width = 0.9,
  draw = {
    \begin{scope}[shift={(0.45,0.47)}]
      \draw (90:0.46) -- (210:0.46) -- (330:0.46) -- cycle;
      \draw (270:0.46) -- (30:0.46) -- (150:0.46) -- cycle;
    \end{scope}
  },
}

% ---------------------------------------------------------------------------
% Enochian alphabet
%
% Letter names follow the Golden Dawn spellings.  Forms were traced from a
% Golden Dawn letter table: each letter sits on the baseline (y=0.1) and
% reaches about 0.92, with serifs as short strokes.  The enochian script maps
% Latin letters to glyphs, sharing Ve (C, K), Gon (I, J, Y) and Vau (U, V, W).

\DeclareEsotericGlyph{goldendawn}{EnochianUn}{
  description = {Enochian letter Un (A)},
  width = 0.68,
  draw = {
    \draw (0.07,0.11) -- (0.59,0.62) -- (0.4,0.89);
    \draw (0.25,0.81) -- (0.25,0.89) -- (0.6,0.89) -- (0.61,0.81);
    \draw (0.08,0.34) -- (0.31,0.12);
  },
}

\DeclareEsotericGlyph{goldendawn}{EnochianPe}{
  description = {Enochian letter Pe (B)},
  width = 0.88,
  draw = {
    \draw (0.07,0.89) -- (0.23,0.89);
    \draw (0.15,0.89) -- (0.42,0.08) -- (0.63,0.66);
    \draw plot[smooth] coordinates {(0.63,0.66) (0.78,0.71) (0.81,0.81) (0.74,0.88) (0.59,0.87)};
    \draw (0.59,0.87) -- (0.59,0.81);
  },
}

